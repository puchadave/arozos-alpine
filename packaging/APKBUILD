# Maintainer: webOwie <build@webowie.com>
pkgname=webowie-nodeos
pkgver="${WEBOWIE_PKGVER:-0.1.0}"
pkgrel=0
pkgdesc="webOwie_nodeOS Alpine-native node operating environment"
url="https://github.com/puchadave/arozos-alpine"
arch="x86_64"
license="GPL-3.0-only"
depends="
	openrc
	sudo
	bash
	ca-certificates
	curl
	wget
	git
	tar
	ffmpeg
	net-tools
	iproute2
	procps-ng
	util-linux
	coreutils
	findutils
	tzdata
	shadow
	cifs-utils
	nfs-utils
	fuse3
"
options="!check !strip"
install="$pkgname.pre-install $pkgname.post-install $pkgname.pre-deinstall"
source="
	webowie-nodeos-runtime.tar.gz
	webowie-nodeos.initd
	webowie-nodeos.confd
"
builddir="$srcdir"

package() {
	# Executable belongs in /usr/bin. ArozOS expects web/ and system/ relative
	# to its working directory, so the product runtime lives in /var/lib.
	install -Dm755 "$srcdir/runtime/webowie-nodeos" "$pkgdir/usr/bin/webowie-nodeos"

	install -d "$pkgdir/var/lib/webowie-nodeos"
	cp -a "$srcdir/runtime/." "$pkgdir/var/lib/webowie-nodeos/"
	rm -f "$pkgdir/var/lib/webowie-nodeos/webowie-nodeos"
	install -d "$pkgdir/var/lib/webowie-nodeos/files" "$pkgdir/var/lib/webowie-nodeos/tmp"

	install -Dm755 "$srcdir/webowie-nodeos.initd" "$pkgdir/etc/init.d/webowie-nodeos"
	install -Dm644 "$srcdir/webowie-nodeos.confd" "$pkgdir/etc/conf.d/webowie-nodeos"
}
